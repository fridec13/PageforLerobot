// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  password           String
  role               Role               @default(USER)
  title              String?            @default("새싹")
  image              String?
  contribution       Int                @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  contributions      Contribution[]
  sentMessages       Message[]          @relation("SentMessages")
  receivedMessages   Message[]          @relation("ReceivedMessages")
  userBadges         UserBadge[]
  createdDocuments   WikiDocument[]     @relation("DocumentCreator")
  modifiedDocuments  WikiDocument[]     @relation("DocumentModifier")
  wikiRevisions      WikiRevision[]
  wikiDiscussions    WikiDiscussion[]
  wikiComments       WikiComment[]
  userContributions  UserContribution[]
  createdDocs        Document[]         @relation("DocCreator")
  modifiedDocs       Document[]         @relation("DocModifier")
  docHistories       DocumentHistory[]  @relation("DocHistoryEditor")
  docChangeRequests  DocumentChangeRequest[] @relation("DocChangeRequestProposer")
  reviewedRequests   DocumentChangeRequest[] @relation("DocChangeRequestReviewer")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Contribution {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // 기여 타입 (wiki, forum, docs 등)
  description String
  points      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  image       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// 위키 문서 모델
model WikiDocument {
  id             String           @id @default(uuid())
  slug           String           @unique
  title          String
  content        String           @db.Text
  isPublished    Boolean          @default(true)
  viewCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdById    String
  lastModifiedById String
  createdBy      User             @relation("DocumentCreator", fields: [createdById], references: [id])
  lastModifiedBy User             @relation("DocumentModifier", fields: [lastModifiedById], references: [id])
  categories     WikiCategory[]   @relation("DocumentToCategory")
  revisions      WikiRevision[]
  discussions    WikiDiscussion[]
  contributions  UserContribution[]
}

// 위키 카테고리 모델
model WikiCategory {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  parentId    String?
  parent      WikiCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    WikiCategory[] @relation("CategoryHierarchy")
  documents   WikiDocument[] @relation("DocumentToCategory")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// 위키 문서 수정 이력 모델
model WikiRevision {
  id         String       @id @default(uuid())
  documentId String
  content    String       @db.Text
  diff       String?      @db.Text
  comment    String
  createdAt  DateTime     @default(now())
  createdById String
  document   WikiDocument @relation(fields: [documentId], references: [id])
  createdBy  User         @relation(fields: [createdById], references: [id])
}

// 위키 문서 토론 모델
model WikiDiscussion {
  id         String        @id @default(uuid())
  documentId String
  title      String
  status     String        @default("open") // open, closed, resolved
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  createdById String
  document   WikiDocument  @relation(fields: [documentId], references: [id])
  createdBy  User          @relation(fields: [createdById], references: [id])
  comments   WikiComment[]
}

// 위키 토론 댓글 모델
model WikiComment {
  id           String        @id @default(uuid())
  discussionId String
  content      String        @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String
  discussion   WikiDiscussion @relation(fields: [discussionId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
}

// 사용자 기여 내역 모델
model UserContribution {
  id          String       @id @default(uuid())
  userId      String
  type        String       // WIKI, DOCUMENT, FORUM
  title       String
  documentId  String?
  document    WikiDocument? @relation(fields: [documentId], references: [id])
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
}

//---------------- 새로 추가하는 Docs 모델 ----------------//

// 기술 문서 모델
model Document {
  id                String    @id @default(uuid())
  title             String
  content           String    @db.Text
  path              String    @unique
  isPublished       Boolean   @default(true)
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  categoryId        String
  createdById       String
  lastModifiedById  String

  // 외래 키 관계
  category          Category  @relation(fields: [categoryId], references: [id])
  createdBy         User      @relation("DocCreator", fields: [createdById], references: [id])
  lastModifiedBy    User      @relation("DocModifier", fields: [lastModifiedById], references: [id])
  
  // 관련 컬렉션
  history           DocumentHistory[]
  changeRequests    DocumentChangeRequest[]
}

// 문서 카테고리 모델
model Category {
  id          String    @id @default(uuid())
  name        String
  path        String    @unique
  description String?
  parentId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 외래 키 관계
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  documents   Document[]
}

// 문서 이력 모델
model DocumentHistory {
  id                String    @id @default(uuid())
  content           String    @db.Text
  version           Int
  changeDescription String?
  createdAt         DateTime  @default(now())
  documentId        String
  editedById        String

  // 외래 키 관계
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editedBy          User      @relation("DocHistoryEditor", fields: [editedById], references: [id])
}

// 문서 변경 요청 모델
model DocumentChangeRequest {
  id              String    @id @default(uuid())
  proposedContent String    @db.Text
  status          String    // pending, approved, rejected
  reviewComment   String?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
  documentId      String
  proposedById    String
  reviewedById    String?

  // 외래 키 관계
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  proposedBy      User      @relation("DocChangeRequestProposer", fields: [proposedById], references: [id])
  reviewedBy      User?     @relation("DocChangeRequestReviewer", fields: [reviewedById], references: [id])
}
