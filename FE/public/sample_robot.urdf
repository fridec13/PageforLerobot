<?xml version="1.0"?>
<robot name="sample_robot">
  <!-- 베이스 링크 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.8 0.2 0.8"/>
      </geometry>
      <material name="base_color">
        <color rgba="0.9 0.4 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- 관절 1 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.8"/>
      </geometry>
      <origin xyz="0 0.4 0" rpy="0 0 0"/>
      <material name="link1_color">
        <color rgba="0.9 0.4 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- 관절 2 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0.8 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="2"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.15 1 0.15"/>
      </geometry>
      <origin xyz="0 0.5 0" rpy="0 0 0"/>
      <material name="link2_color">
        <color rgba="0.9 0.4 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- 관절 3 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 1 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="2"/>
  </joint>

  <link name="link3">
    <visual>
      <geometry>
        <box size="0.15 1 0.15"/>
      </geometry>
      <origin xyz="0 0.5 0" rpy="0 0 0"/>
      <material name="link3_color">
        <color rgba="0.9 0.4 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- 관절 4 (그리퍼) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="gripper"/>
    <origin xyz="0 1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="2"/>
  </joint>

  <link name="gripper">
    <visual>
      <geometry>
        <box size="0.2 0.08 0.08"/>
      </geometry>
      <origin xyz="0.1 0.1 0" rpy="0 0 0"/>
      <material name="gripper_color">
        <color rgba="0.9 0.4 0.1 1"/>
      </material>
    </visual>
    <visual>
      <geometry>
        <box size="0.2 0.08 0.08"/>
      </geometry>
      <origin xyz="-0.1 0.1 0" rpy="0 0 0"/>
      <material name="gripper_color"/>
    </visual>
  </link>
</robot> 