// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Auth.js 관련 모델
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String                  @id @default(cuid())
  name              String?
  email             String?                 @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              UserRole                @default(USER)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  nickname          String?
  title             String? // 칭호
  contributionCount Int                     @default(0) // 기여 횟수
  accounts          Account[]
  sessions          Session[]
  // 문서 관련 관계
  documents         Document[]              @relation("CreatedDocuments")
  editedDocuments   Document[]              @relation("EditedDocuments")
  changeRequests    DocumentChangeRequest[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 사용자 역할
enum UserRole {
  ADMIN
  MODERATOR
  USER
}

// 문서 모델
model Document {
  id             String   @id @default(cuid())
  title          String
  content        String
  path           String   @unique
  categoryId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  lastEditedById String
  isPublished    Boolean  @default(false)
  version        Int      @default(1)

  // 관계
  createdBy      User                    @relation("CreatedDocuments", fields: [createdById], references: [id])
  lastEditedBy   User                    @relation("EditedDocuments", fields: [lastEditedById], references: [id])
  history        DocumentHistory[]
  changeRequests DocumentChangeRequest[]
  category       Category                @relation(fields: [categoryId], references: [id])
}

// 문서 이력 모델
model DocumentHistory {
  id                String   @id @default(cuid())
  documentId        String
  content           String
  version           Int
  editedById        String
  editedAt          DateTime @default(now())
  changeDescription String?

  // 관계
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// 카테고리 모델
model Category {
  id          String   @id @default(cuid())
  name        String
  path        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())

  // 관계
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  documents     Document[]
}

// 변경 요청 모델
model DocumentChangeRequest {
  id              String        @id @default(cuid())
  documentId      String
  proposedContent String
  proposedById    String
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  reviewComment   String?

  // 관계
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  proposedBy User     @relation(fields: [proposedById], references: [id])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
